{
  "name": "xlink-memory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "dsh-xlink 内置本地记忆插件：读取记忆、项目交接与已审核经验，提供 memory_search / memory_read / memory_propose / memory_context 工具",
  "main": "host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    }
  }
}
