{
  "name": "xlink-official-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "dsh-xlink 官网对话引用：在工作台按需选择 DeepSeek、MiniMax、ChatGPT 会话，保存固定正文并用于当前提问。",
  "main": "host/index.js",
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  }
}
