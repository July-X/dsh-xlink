{
  "identifier": "mcode-remote",
  "description": "MiniMax workbench window appearance, edit menu, login-popup shutdown, shell raise (the injected pull-string lamp) and standard external links.",
  "windows": ["mcode-workbench"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "allow-show-workbench-edit-menu",
    "allow-close-mcode-popups",
    "allow-window-appearance",
    "allow-get-shell-theme",
    "allow-focus-main-shell",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
