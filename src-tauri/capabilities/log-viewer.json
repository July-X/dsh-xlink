{
  "identifier": "log-viewer",
  "description": "The standalone log viewer window ... 它现在是自绘标题栏（2026-10-08），关闭键由前端承担，因此需要 start-dragging（拖窗）与 minimize。",
  "windows": [
    "log-viewer"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-theme",
    "allow-log-viewer",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize"
  ]
}
