{
  "name": "dsh-xlink",
  "version": "0.3.7-rc.2",
  "private": true,
  "description": "DeepSeek Harness 桌面外壳：内嵌管理面板 + 内核版本管理与更新",
  "repository": {
    "type": "git",
    "url": "https://github.com/July-X/dsh-xlink.git"
  },
  "homepage": "https://github.com/July-X/dsh-xlink",
  "bugs": {
    "url": "https://github.com/July-X/dsh-xlink/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "deps": "node scripts/install.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "build": "tauri build",
    "build:ui": "vite build",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:code-budget": "node scripts/check-code-budget.mjs",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --all-targets --manifest-path src-tauri/Cargo.toml && cargo check --release --all-targets --manifest-path src-tauri/Cargo.toml",
    "check:ui-bundle": "node scripts/check-ui-bundle-budget.mjs",
    "check": "npm run check:invariants && npm run check:code-budget && npm run test:scripts && npm run test:ui && npm run test:smoke && npm run check:rust && npm run build:ui && npm run check:ui-bundle",
    "test:release-assets": "node --test scripts/normalize-release-assets.test.mjs",
    "test:release-manifest": "node --test scripts/generate-updater-manifest.test.mjs",
    "test:titlebar-pulse": "node --test scripts/titlebar-pulse.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:smoke": "node scripts/smoke-pullstring.mjs",
    "test:ui": "node --test ui/test/*.test.js",
    "build:mac-intel": "tauri build --target x86_64-apple-darwin",
    "build:win": "tauri build --target x86_64-pc-windows-msvc",
    "test:file-perf": "node scripts/verify-dsh-file-perf.mjs",
    "check:signing-keys": "node scripts/check-signing-keys.mjs",
    "check:ui-bindings": "node scripts/check-ui-bindings.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.4.3"
  }
}
