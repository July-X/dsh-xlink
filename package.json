{
  "name": "dsh-xlink",
  "version": "0.1.2-rc.6",
  "private": true,
  "description": "DeepSeek Harness 桌面外壳：内嵌管理面板 + 内核版本管理与更新",
  "repository": {
    "type": "git",
    "url": "https://github.com/July-X/dsh-xlink.git"
  },
  "homepage": "https://github.com/July-X/dsh-xlink",
  "bugs": {
    "url": "https://github.com/July-X/dsh-xlink/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "deps": "node scripts/install.mjs",
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "tauri build",
    "build:ui": "vite build",
    "test:release-assets": "node --test scripts/normalize-release-assets.test.mjs",
    "test:release-manifest": "node --test scripts/generate-updater-manifest.test.mjs",
    "test:ui": "node --test ui/test/officialChatTabs.test.js ui/test/statusRefresh.test.js ui/test/harnessHealth.test.js ui/test/loading.test.js ui/test/progress.test.js ui/test/updateChecks.test.js ui/test/installLatest.test.js ui/test/kernelSwitch.test.js",
    "build:mac-intel": "tauri build --target x86_64-apple-darwin",
    "build:win": "tauri build --target x86_64-pc-windows-msvc"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.5",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.4.3"
  }
}
