{
  "name": "dsh-xlink",
  "version": "0.6.1-rc.3",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "description": "DeepSeek Harness 桌面外壳：内嵌管理面板 + 内核版本管理与更新",
  "repository": {
    "type": "git",
    "url": "https://github.com/July-X/dsh-xlink.git"
  },
  "homepage": "https://github.com/July-X/dsh-xlink",
  "bugs": {
    "url": "https://github.com/July-X/dsh-xlink/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "deps": "node scripts/install.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite",
    "build": "npm run prep:builtin && tauri build",
    "build:ui": "vite build",
    "check:invariants": "node scripts/check-invariants.mjs",
    "check:duplicates": "node scripts/check-code-duplicates.mjs",
    "check:static": "npm run check:invariants && npm run check:duplicates && npm run check:webdriver-gating && npm run check:builtin",
    "check:js": "npm run check:static && npm run build:protocol-fixture && npm run test:scripts && npm run test:ui && npm run test:smoke && npm run test:plugin && npm run test:probe && npm run build:ui && npm run check:ui-bundle",
    "check:rust:ci": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo test --manifest-path src-tauri/Cargo.toml --locked && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings",
    "check:rust": "npm run check:rust:ci && cargo check --release --all-targets --manifest-path src-tauri/Cargo.toml --locked",
    "check:ui-bundle": "node scripts/check-ui-bundle-budget.mjs",
    "check:webdriver-gating": "node scripts/check-webdriver-gating.mjs",
    "e2e": "wdio run ./e2e/wdio.conf.mjs",
    "check": "npm run check:js && npm run check:rust",
    "test:release-assets": "node --test scripts/normalize-release-assets.test.mjs",
    "test:release-manifest": "node --test scripts/generate-updater-manifest.test.mjs",
    "test:titlebar-pulse": "node --test scripts/titlebar-pulse.test.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:smoke": "node scripts/smoke-pullstring.mjs",
    "test:ui": "node --test --test-force-exit ui/test/*.test.js",
    "build:mac-intel": "npm run prep:builtin && tauri build --target x86_64-apple-darwin",
    "build:win": "npm run prep:builtin && tauri build --target x86_64-pc-windows-msvc",
    "check:signing-keys": "node scripts/check-signing-keys.mjs",
    "check:ui-bindings": "node scripts/check-ui-bindings.mjs",
    "analyze:prompt-cache": "node scripts/analyze-prompt-cache.mjs",
    "prep:builtin": "node scripts/prepare-builtin-plugins.mjs",
    "build:protocol-fixture": "cargo build --manifest-path src-tauri/Cargo.toml --locked --example p1_protocol_fixture",
    "check:builtin": "node scripts/prepare-builtin-plugins.mjs --check",
    "test:plugin": "node --test plugins/openai-oauth/test/*.test.mjs plugins/ponytail/test/*.test.mjs plugins/memory/test/*.test.mjs plugins/official-chat/test/*.test.mjs",
    "test:probe": "node --test src-tauri/examples/*.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@lucide/vue": "^1.49.0",
    "element-plus": "^2.14.5",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-service": "^1.5.0",
    "vite": "^8.3.4",
    "webdriverio": "^9.32.0"
  }
}
